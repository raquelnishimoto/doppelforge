{
  "name": "@doppelforge/runtime",
  "version": "0.1.0",
  "description": "Universal mock generator for browser and Node",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@doppelforge/ir": "workspace:*"
  },
  "peerDependencies": {
    "@faker-js/faker": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": false
    }
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "doppelforge",
    "mock",
    "testing",
    "faker",
    "msw"
  ],
  "license": "MIT"
}
